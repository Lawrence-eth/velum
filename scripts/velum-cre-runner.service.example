[Unit]
Description=Velum bounded CRE simulation executor
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/projects/active/velum
EnvironmentFile=%h/.secrets/velum-cre-runner.env
# Adjust Node/Bun/CRE paths for your host. Build with bun run build:runner first.
Environment=PATH=/home/ubuntu/.local/bin:/home/ubuntu/.bun/bin:/home/ubuntu/.local/node-v22.23.1-linux-arm64/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/ubuntu/.local/node-v22.23.1-linux-arm64/bin/node --no-addons /home/ubuntu/projects/active/velum/artifacts/cre-runner.mjs
Restart=on-failure
RestartSec=10
MemoryMax=1200M
TasksMax=80
UMask=0077

[Install]
WantedBy=default.target
