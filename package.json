{
  "name": "veilpay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "bun test test/policy.test.ts",
    "typecheck": "tsc --noEmit",
    "dev": "bun scripts/local-server.ts",
    "deploy": "node --no-addons node_modules/wrangler/bin/wrangler.js deploy",
    "simulate": "cre workflow simulate workflow --target staging-settings --non-interactive --trigger-index 0",
    "dev:worker": "node --no-addons node_modules/wrangler/bin/wrangler.js dev",
    "test:contract": "bun build scripts/contract-test.ts --target node --packages external --outfile artifacts/contract-test.mjs && node --no-addons artifacts/contract-test.mjs",
    "test:browser": "node --no-addons scripts/browser-test.mjs"
  },
  "dependencies": {
    "@chainlink/cre-sdk": "1.18.0",
    "viem": "2.34.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@ethereumjs/common": "4.4.0",
    "@ethereumjs/util": "9.1.0",
    "@ethereumjs/vm": "8.1.1",
    "@playwright/test": "1.63.0",
    "@types/bun": "1.4.2",
    "solc": "0.8.30",
    "typescript": "5.9.3",
    "wrangler": "4.30.0",
    "@ethereumjs/block": "5.3.0"
  }
}
