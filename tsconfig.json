{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ESNext",
      "DOM"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "bun"
    ]
  },
  "include": [
    "src/**/*.ts",
    "workflow/**/*.ts",
    "test/policy.test.ts",
    "test/batch.test.ts",
    "worker-configuration.d.ts",
    "test/ledger.test.ts",
    "test/agent.test.ts",
    "test/cre-jobs.test.ts"
  ]
}
