{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "veilpay",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "workers_dev": false,
  "routes": [{ "pattern": "veilpay.aethe.me", "custom_domain": true }]
}
